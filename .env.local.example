# =============================================================================
# Cloody Cloud Environment (Default)
# =============================================================================
# 기본 운영 모드: Vercel + Supabase + Cloudflare R2

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
GALLERY_PASSWORD=change-this-password

# Supabase (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (https://dash.cloudflare.com/?to=/:account/r2/overview)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=cloody
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Cron (optional, recommended in production)
CRON_SECRET=change-this-cron-secret

# Email / Magic Link (optional but recommended)
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
EMAIL_FROM=Cloody <noreply@cloody.app>

# TOTP MFA (optional)
TOTP_SECRET=your-base32-secret

# Passkey / WebAuthn (optional for local; required for production domain)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Optional local S3-compatible mode (MinIO, etc.)
# -----------------------------------------------------------------------------
# Use only when you intentionally want local object storage instead of R2.
# If R2_ENDPOINT is set, the app uses this endpoint with S3 path-style.
# R2_ENDPOINT=http://localhost:9000
